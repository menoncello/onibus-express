# Credenciais locais óbvias, sem segredo real (AD-16). Copie para .env antes de
# `docker-compose up --build` — ou deixe os padrões, que já funcionam sem edição.
POSTGRES_DB=onibus
POSTGRES_USER=onibus
POSTGRES_PASSWORD=onibus_local_dev

# Testes E2E (Playwright) — sem API_URL: AD-11 proíbe URL absoluta de API,
# os testes chamam /api/* relativo a BASE_URL, igual ao frontend.
TEST_ENV=local
BASE_URL=http://localhost
